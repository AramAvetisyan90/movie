<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HOTFILMS</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Смотрите неограниченное количество фильмов и сериалов онлайн. Лучший опыт кинопоказа.")" />
    <meta name="keywords" content="@(ViewData["Keywords"] ?? "фильмы, кинопоказ, смотреть онлайн, сериалы, стриминг")" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="@ViewData["Title"] - HOTFILMS">
    <meta property="og:description" content="@(ViewData["Description"] ?? "Смотрите неограниченное количество фильмов и сериалов онлайн. Лучший опыт кинопоказа.")">
    <meta property="og:site_name" content="HOTFILMS">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <a class="brand-logo" href="/">HOTFILMS</a>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer>
        <p>&copy; 2025 - HOTFILMS ПРЕМИУМ</p>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>