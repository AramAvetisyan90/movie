@page "{title?}"
@model WatchModel
@{
    ViewData["Title"] = Model.Movie?.Title;
    ViewData["HideFooter"] = true; // Optional: hide footer on player page if desired, logic would need to be in Layout
}

<div class="watch-container">
    <div class="back-link">
        <a asp-page="/Index">&larr; Назад к фильмам</a>
    </div>

    @if (Model.Movie != null)
    {
        <div class="video-wrapper">
             <video id="moviePlayer" controls autoplay muted playsinline preload="auto" class="video-player" poster="@Model.Movie.PosterUrl">
                <source src="@Url.Page("/Watch", "Video", new { id = Model.Movie.Id })" type="video/mp4">
                Ваш браузер не поддерживает воспроизведение видео.
            </video>
        </div>

        <div class="movie-details">
            <h1 class="watch-title">@Model.Movie.Title <span class="watch-year">(@Model.Movie.ReleaseYear)</span></h1>
            <div class="watch-meta">
                @foreach (var g in Model.Movie.Genre.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    <span class="genre-tag">@g</span>
                }
            </div>
            <p class="watch-desc">@Model.Movie.Description</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var video = document.getElementById('moviePlayer');
            if (video) {
                // When metadata (duration) is loaded
                video.addEventListener('loadedmetadata', function() {
                    console.log("Metadata loaded. Duration: " + video.duration);
                    // Video duration is now known
                });

                // Error handling
                video.addEventListener('error', function(e) {
                    console.error("Video Error:", video.error);
                    var source = video.querySelector('source');
                    if (source) {
                        console.log("Failed source URL:", source.src);
                    }
                });

                // Browsers often require one user interaction to play with sound.
                // We start muted to ensure it plays, and can show a 'unmute' hint.
                video.play().catch(error => {
                    console.log("Autoplay check:", error);
                });
            }
        });
    </script>
}
